{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AutoGitr/LumiereDB/main/schema/entry.schema.json",
  "title": "LumiereDB entry",
  "description": "One dataset entry. Every field is named and typed exactly as Lumiere names and types it, so the app stores what it downloads without renaming or converting anything.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "media_type",
    "title",
    "year",
    "tmdb_id",
    "tvdb_id",
    "imdb_id",
    "poster_url",
    "background_url",
    "youtube_id"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "media_type": {
            "const": "show"
          }
        },
        "required": ["media_type"]
      },
      "then": {
        "required": ["seasons"]
      }
    },
    {
      "if": {
        "properties": {
          "media_type": {
            "const": "movie"
          }
        },
        "required": ["media_type"]
      },
      "then": {
        "not": {
          "required": ["seasons"]
        }
      }
    }
  ],
  "properties": {
    "media_type": {
      "enum": ["movie", "show"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "year": {
      "type": ["integer", "null"],
      "minimum": 1000,
      "maximum": 9999
    },
    "tmdb_id": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "tvdb_id": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "imdb_id": {
      "type": ["string", "null"],
      "pattern": "^tt[0-9]+$"
    },
    "poster_url": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "background_url": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "youtube_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "seasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["season_num", "poster_url"],
        "properties": {
          "season_num": {
            "type": "integer",
            "minimum": 0
          },
          "poster_url": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "license"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
